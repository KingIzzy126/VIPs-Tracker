# Discord: channel settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Discord: enable Developer Mode, then right-click the VIP Ping role > Copy Role ID
VIP_PING_ROLE_ID=

# Roblox login cookie from a SEPARATE alt account. Never use your main.
ROBLOSECURITY=

# Optional settings
POLL_SECONDS=30
OFFLINE_POLLS=4
PING_COOLDOWN_MINUTES=15
POST_HIDDEN=false
